# --- Claude Code accounts ---------------------------------------------------
# The UI always asks which account and chat to use. These defaults match the
# two local profiles and can be overridden without exposing paths to the browser.
# CLAUDE_ONE_CONFIG_DIR=~/.claude-one
# CLAUDE_TWO_CONFIG_DIR=~/.claude-two
# CLAUDE_ONE_LABEL=Claude account 1
# CLAUDE_TWO_LABEL=Claude account 2
# CLAUDE_BIN=~/.local/bin/claude

# --- Codex accounts --------------------------------------------------------
# The single Codex account falls back to the process CODEX_HOME when it is set.
# CODEX_ONE_HOME=~/.codex
# CODEX_ONE_LABEL=Codex account 1
# CODEX_BIN=codex

# Note: the app's port (4823) is set in package.json scripts (`next dev -p 4823`),
# not here — Next.js does not read PORT from .env files for the dev server.
