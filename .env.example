# --- Ollama integration -----------------------------------------------------
# URL of your local Ollama daemon. Cloud models are proxied through it,
# so this stays local even when using a ":cloud" model.
OLLAMA_HOST=http://127.0.0.1:11434

# Model tag to use. Cloud models end with ":cloud" and require `ollama signin`.
# minimax-m2 was retired 2026-06-16; minimax-m2.7 is the current MiniMax.
OLLAMA_MODEL=minimax-m2.7:cloud

# Optional Claude Code overrides for the "Run plan review" button. When
# CLAUDE_CONFIG_DIR is unset, the app looks for a profile containing the
# plan-review skill in ~/.claude, ~/.claude-one, or ~/.claude-two.
# CLAUDE_CONFIG_DIR=~/.claude
# CLAUDE_BIN=~/.local/bin/claude

# Note: the app's port (4823) is set in package.json scripts (`next dev -p 4823`),
# not here — Next.js does not read PORT from .env files for the dev server.
